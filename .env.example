# ═══════════════════════════════════════════════════════════════════════════
# Sage by VirtuaLab Digital — Environment Variables Template
# ═══════════════════════════════════════════════════════════════════════════
# Copy this file to `.env` for local dev, or set each var as a Cloudflare secret:
#   npx wrangler pages secret put SECRET_NAME --project-name=sage-seo
# ═══════════════════════════════════════════════════════════════════════════

# ─── Database (local dev uses SQLite; production uses Cloudflare D1) ─────────
# Local: file:./db/custom.db (already set in .env)
# Production: D1 binding "DB" — no DATABASE_URL needed, Prisma uses the binding
DATABASE_URL="file:./db/custom.db"

# ─── NextAuth ───────────────────────────────────────────────────────────────
# Generate: openssl rand -base64 32
NEXTAUTH_SECRET="your-nextauth-secret-here"
# Local: http://localhost:3000 · Production: https://sage.virtualab.digital
NEXTAUTH_URL="http://localhost:3000"

# ─── Stripe (Lane 2) ────────────────────────────────────────────────────────
# Get from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# ─── DataForSEO (BYOK — users can bring their own, or use platform keys) ────
# Get from https://dataforseo.com/
DATAFORSEO_LOGIN="your@dataforseo.login"
DATAFORSEO_PASSWORD="your-dataforseo-password"

# ─── LLM Provider (BYOK — users can bring their own, or use platform keys) ──
# OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY="sk-..."
# Anthropic (optional): https://console.anthropic.com/
ANTHROPIC_API_KEY="sk-ant-..."

# ─── Google APIs (GSC + GA4 OAuth) ──────────────────────────────────────────
# Create OAuth client: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# ─── Encryption ─────────────────────────────────────────────────────────────
# 32-byte key for encrypting user BYOK API keys at rest
# Generate: openssl rand -hex 32
SAGE_ENCRYPTION_KEY="your-32-byte-encryption-key"

# ─── App URL ────────────────────────────────────────────────────────────────
APP_URL="http://localhost:3000"

# ─── Cloudflare D1 (production only — set via wrangler.toml) ────────────────
# These are NOT env vars — they're Cloudflare bindings configured in wrangler.toml
# D1 binding: DB (database)
# KV binding: SAGE_KV (sessions/cache)
